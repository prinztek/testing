    - target: {fileID: 8902907873516035281, guid: 8696efd15abc1d7468b2986604dc05f1, type: 3}
      propertyPath: m_fontSizeBase
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 9091669035569178768, guid: 8696efd15abc1d7468b2986604dc05f1, type: 3}
      propertyPath: m_Text
      value: "That\u2019s Correct!\n\nThe rune stones were A, B, and C. Since all
        three runes must be selected and only the group matters, different orders
        do not create new results. This is called a combination.\n\nLet\u2019s look
        at the selection:\n\nA, B, C\n\nEven if we write ABC, ACB, or BAC, they all
        represent the same group of runes.\n\nThere is only 1 possible selection.\n\n\nThe
        three rune stones have exactly 1 combination when all are selected."
      objectReference: {fileID: 0}
    m_RemovedComponents:
    - {fileID: 3729752679562399422, guid: 8696efd15abc1d7468b2986604dc05f1, type: 3}
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 8696efd15abc1d7468b2986604dc05f1, type: 3}
