    - target: {fileID: 1916350502496263137, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_text
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Text
      value: "That\u2019s Correct!\r\n\r\nEvaluate the factorial\r\n\r\n0! = 1\r\n\r\nSubstitute
        into the equation\r\n\r\nC(n + 1, 7) = 1\r\n\r\nUse the combination identity\r\n\r\nC(n,
        n) = 1\r\n\r\nMatch the expressions\r\n\r\nn + 1 = 7\r\n\r\nSubtract 1 from
        both sides\r\n\r\nn + 1 \u2212 1 = 7 \u2212 1\r\n\r\nSimplify\r\n\r\nn =
        6\r\n"
      objectReference: {fileID: 0}
