      value: 
      objectReference: {fileID: 1606178655}
    - target: {fileID: 2517586419709550625, guid: f35b204535a5b05479abb11057a7423d, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_MethodName
      value: CloseCanvas
      objectReference: {fileID: 0}
    - target: {fileID: 2548793943930283753, guid: f35b204535a5b05479abb11057a7423d, type: 3}
      propertyPath: m_Size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 2548793943930283753, guid: f35b204535a5b05479abb11057a7423d, type: 3}
      propertyPath: m_Text
      value: 'When a bracelet has a clasp, the clasp fixes the starting position.


        Because
        of this, rotation creates a new arrangement.


        So we first count
        all linear arrangements with:


        n!


        However, the bracelet
        can still be flipped.


        Flipping creates mirror arrangements that
        are considered the same.


        So we divide by 2.


        Bracelet
        with Lock = \frac{n!}{2}


        For three beads:


        \frac{3!}{2}
        = 3'
      objectReference: {fileID: 0}
