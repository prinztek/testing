      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Text
      value: "That\u2019s Correct!\n\nSubstitute the factorials into the permutation
        formula\n\nP(6, 6) = \\frac{6!}{(6 - 6)!}\n\nSimplify the expression\n\nP(6,
        6) = \\frac{9!}{0!}\n\nSubstitute the factorial values\n\n9! = 720\n\n0!
        = 1\n\nDivide\n\n\\frac{720}{1} = 720\n\nP(6, 6) = 720"
      objectReference: {fileID: 0}
