    - target: {fileID: 1916350502496263137, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_text
      value: 6r
      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Text
      value: "That\u2019s Correct!\r\n\r\nIdentify the condition - The ball selected
        is not green, so only red and blue balls are considered.\r\n\r\nFind the
        number of balls that are not green\r\n\r\nNot green = red + blue\r\n\r\n5
        + 4 = 9\r\n\r\nFind the number of favorable outcomes\r\n\r\nRed balls that
        are not green = 5\r\n\r\nUse the conditional probability formula\r\n\r\nP(\\text{Red}
        \\mid \\text{Not Green}) =\r\n\\frac{\\text{Number of red balls that are
        not green}}{\\text{Number of balls that are not green}}\r\n\r\nSubstitute
        the values\r\n\r\nP(\\text{Red} \\mid \\text{Not Green}) = \\frac{5}{9}\r\n\r\nFinal
        answer\r\n\r\nP(\\text{Red} \\mid \\text{Not Green}) = \\frac{5}{9}\r\n"
      objectReference: {fileID: 0}
