--- !u!114 &163870301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 163870298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a11dd23e08e5cb942a6a6b4da8d43711, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TEXDrawRuntime::TexDrawLib.TEXDraw
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_Alignment: {x: 0.5, y: 0.5}
  m_Text: "That\u2019s Correct!\r\n\r\nIdentify the universal set\r\n\r\nU = {1,
    2, 3, 4, 5, 6, 7}\r\n\r\nThese are all the elements found in the given sets A,
    B, and C.\r\n\r\nIdentify the given sets\r\n\r\nA = {1, 2, 3, 4, 5, 6}\r\nB =
    {2, 4, 5, 6}\r\nC = {1, 6, 7}\r\n\r\nFind A \\cap B\r\n\r\nA \\cap B means elements
    that are in both A and B.\r\n\r\nCompare the elements of A and B and list the
    common numbers.\r\n\r\nA \\cap B = {2, 4, 5, 6}\r\n\r\nFind B' \\cap C'\r\n\r\nFirst
    find the complements.\r\n\r\nB' means elements in the universal set that are
    not in B.\r\n\r\nB' = {1, 3, 7}\r\n\r\nC' means elements in the universal set
    that are not in C.\r\n\r\nC' = {2, 3, 4, 5}\r\n\r\nNow find the intersection.\r\n\r\nB'
    \\cap C' means elements that appear in both B' and C'.\r\n\r\nB' \\cap C' = {3}\r\n\r\nFind
    A \\cup B\r\n\r\nA \\cup B means elements that are in A or in B.\r\n\r\nCombine
    the elements of A and B without repeating numbers.\r\n\r\nA \\cup B = {1, 2,
    3, 4, 5, 6}\r\n\r\nFind B' \\cup C'\r\n\r\nUse the complements found earlier.\r\n\r\nB'
    = {1, 3, 7}\r\nC' = {2, 3, 4, 5}\r\n\r\nCombine the elements of B' and C' without
    repeating numbers.\r\n\r\nB' \\cup C' = {1, 2, 3, 4, 5, 7}\r\n\r\nFind (A \\cup
    B) \\cap C\r\n\r\nFirst find the union.\r\n\r\nA \\cup B = {1, 2, 3, 4, 5, 6}\r\n\r\nNow
    find the intersection with C.\r\n\r\nC = {1, 6, 7}\r\n\r\nList the elements that
    appear in both sets.\r\n\r\n(A \\cup B) \\cap C = {1, 6}\r\n"
  m_Size: 6
  m_ScrollArea:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
  m_Padding:
    left: 10
    right: 10
    top: 10
    bottom: 10
  m_Overflow: 0
