--- !u!114 &1166208839
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1166208836}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a11dd23e08e5cb942a6a6b4da8d43711, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TEXDrawRuntime::TexDrawLib.TEXDraw
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_Alignment: {x: 0.5, y: 0.5}
  m_Text: "That\u2019s Correct!\r\n\r\nIdentify the given values\r\n\r\nn(A \\cup
    B) = 20\r\nn(A \\cap B) = 3\r\nn(B) = 13\r\n\r\nFind y using n(B)\r\n\r\nn(B)
    = 3 + y\r\n\r\nSubstitute the value of n(B)\r\n\r\n13 = 3 + y\r\n\r\nSolve for
    y\r\n\r\ny = 13 - 3\r\ny = 10\r\n\r\nFind x using n(A \\cup B)\r\n\r\nn(A \\cup
    B) = x + 3 + y\r\n\r\nSubstitute the known values\r\n\r\n20 = x + 3 + 10\r\n\r\nSimplify\r\n\r\n20
    = x + 13\r\n\r\nSolve for x\r\n\r\nx = 20 - 13\r\nx = 7\r\n\r\nTherefore,\r\n\r\nx
    = 7 and y = 10\r\n"
  m_Size: 6
  m_ScrollArea:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
  m_Padding:
    left: 10
    right: 10
    top: 10
    bottom: 10
  m_Overflow: 0
