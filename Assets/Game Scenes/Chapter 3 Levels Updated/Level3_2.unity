    - target: {fileID: 1916350502496263137, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_text
      value: 6r
      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 2298647161643049540, guid: 0222a1b4f9c504f4cb194ba535c119ea, type: 3}
      propertyPath: m_Text
      value: "That\u2019s Correct!\r\n\r\nUse the combination identity\r\n\r\nC(n,
        n \u2212 1) = n\r\n\r\nApply the identity\r\n\r\nC(6r, 6r \u2212 1) = 6r\r\n\r\nSubstitute
        the value of the other combination\r\n\r\nC(4, 2) = 6\r\n\r\nSubstitute into
        the equation\r\n\r\n6r = 12 + 6\r\n\r\nAdd the right side\r\n\r\n6r = 18\r\n\r\nDivide
        both sides by 6\r\n\r\nr = 3\r\n"
      objectReference: {fileID: 0}
