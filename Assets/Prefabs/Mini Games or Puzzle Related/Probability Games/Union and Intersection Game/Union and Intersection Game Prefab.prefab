--- !u!114 &4773430625172576353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5086722492763475566}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a11dd23e08e5cb942a6a6b4da8d43711, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TEXDrawRuntime::TexDrawLib.TEXDraw
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_Alignment: {x: 0.5, y: 0.5}
  m_Text: "That\u2019s Correct!\n\nIdentify the universal set\n\nU = {1, 2, 3, 4,
    5, 6, 7, 8}\n\nThese are all possible chips that can be drawn.\n\nIdentify Event
    A (multiples of 4)\n\nA = {4, 8}\n\nIdentify Event B (even numbers)\n\nB = {2,
    4, 6, 8}\n\nFind the union\n\nA \u222A B means elements that are in A or in B.\n\nCombine
    the elements of A and B without repeating numbers.\n\nA \u222A B = {2, 4, 6,
    8}\n\nFind the intersection\n\nA \u2229 B means elements that are in both A and
    B.\n\nA \u2229 B = {4, 8}\n\nFind the complement of A\n\nA\u2032 means elements
    in the universal set that are not in A.\n\nA\u2032 = {1, 2, 3, 5, 6, 7}\n\nFind
    the union of the complements\n\nFirst find the complement of B.\n\nB\u2032 =
    {1, 3, 5, 7}\n\nCombine the elements of A\u2032 and B\u2032.\n\nA\u2032 \\cup
    B\u2032 = {1, 2, 3, 5, 6, 7}\n"
  m_Size: 6
  m_ScrollArea:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
  m_Padding:
    left: 10
    right: 10
    top: 10
    bottom: 10
  m_Overflow: 0
