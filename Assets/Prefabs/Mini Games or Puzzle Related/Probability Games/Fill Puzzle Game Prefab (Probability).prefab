  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a11dd23e08e5cb942a6a6b4da8d43711, type: 3}
  m_Name: 
  m_EditorClassIdentifier: TEXDrawRuntime::TexDrawLib.TEXDraw
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_Alignment: {x: 0.5, y: 0.5}
  m_Text: "That\u2019s Correct!\r\n\r\nUse the combination identity\r\n\r\nC(n, n
    \u2212 1) = n\r\n\r\nApply the identity\r\n\r\nC(6r, 6r \u2212 1) = 6r\r\n\r\nSubstitute
    the value of the other combination\r\n\r\nC(4, 2) = 6\r\n\r\nSubstitute into
    the equation\r\n\r\n6r = 12 + 6\r\n\r\nAdd the right side\r\n\r\n6r = 18\r\n\r\nDivide
    both sides by 6\r\n\r\nr = 3\r\n"
  m_Size: 6
  m_ScrollArea:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
  m_Padding:
    left: 5
    right: 5
    top: 2
    bottom: 2
  m_Overflow: 0
