  m_Alignment: {x: 0.5, y: 0.5}
  m_Text: "That's  Correct!\n\n\u201CThe rune stones were A, B, and C. Since order
    matters, each different arrangement forms a new result. This is called a permutation.\n\nLet\u2019s
    list them:\n\nABC, ACB, BAC, BCA, CAB, CBA\n\nThere are 6 total arrangements.\n\nWe
    can calculate this using factorial notation:\n\n3! = 3 \xD7 2 \xD7 1 = 6\n\nThe
    three rune stones have 6 permutations.\u201D"
  m_Size: 6
  m_ScrollArea:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
  m_Padding:
    left: 5
    right: 5
